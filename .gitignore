# ---- 构建产物 ----
build/
build-fw/
*.o
*.exe
*.elf
*.bin
*.map

# ---- ESP-IDF ----
# sdkconfig 由 sdkconfig.defaults 生成，不入库（与官方仓一致）
sdkconfig
sdkconfig.old
dependencies.lock
managed_components/

# ---- 第三方数据源（体积大，按 docs/data-sources.md 自行下载）----
# Veekun 的 CSV 数据集，约 12 MB，gen_gen3_data.py 的输入
#
# 例外：type_efficacy.csv 只有 3 KB **随仓库入库**。它是属性克制表的唯一
# 数据源，而那张表历史上手写错过 14 处（见 tools/type_chart.py）。
# 让这份 CSV 跟着仓库走，才能在全新克隆上照样做全量校验。
# 注意必须用 `data/csv/*` 而不是 `data/csv/`：后者会让 git 根本不进入该目录，
# 底下的 `!` 例外永远不会生效。
data/csv/*
!data/csv/type_efficacy.csv
# 字体源文件（得意黑，约 2.6 MB，SIL OFL 1.1）
# 生成的 gen/font_app_16.c 已入库，所以构建不需要它
data/fonts/

# ---- 可再生的中间产物 ----
# 量化后的 PNG（精灵图的中间产物，最终产物是 gen/poke_sprites.c）
data/sprites_4bpp/
# 宝可梦小图标量化后的 PNG（中间产物，最终产物是 gen/poke_icons.c）
data/icons_4bpp/
data/icons_raw/
# 预览图（make sprites-preview / make font-preview / make readme-images 的输出）
data/sprites_preview/
data/font_preview/
data/screen_preview/
# AI 对战基准（make bench-teams --csv）的输出，随时可重跑
data/ai_bench/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
